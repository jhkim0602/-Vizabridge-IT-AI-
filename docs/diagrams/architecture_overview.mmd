    classDef rev fill:#fce7f3,stroke:#ec4899,stroke-width:2px,color:#1e1e1e

    subgraph S1["입력&nbsp;"]
        HWP["정부 HWP 매뉴얼&nbsp;&nbsp;<br/>체류 · 사증&nbsp;&nbsp;<br/>source of truth&nbsp;&nbsp;"]:::source
    end

    subgraph S2["컴파일 — LLM 1회 + 결정적 5단계&nbsp;"]
        direction TB
