        PAGES["페이지 인덱스&nbsp;&nbsp;<br/>pdfplumber 캐시&nbsp;&nbsp;"]:::det
        PDF --> PAGES
    end

    subgraph S4["사람 검수&nbsp;"]
        REV["Notion 검수 DB&nbsp;&nbsp;<br/>행 단위 검토&nbsp;&nbsp;"]:::rev
    end

    HWP --> MD
    HWP -.->|"HWP &rarr; PDF&nbsp;"| PDF
    PAGES --> CSV
    CSV --> REV
